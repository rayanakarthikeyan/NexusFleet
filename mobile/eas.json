{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "node": "22.23.3",
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "phone": {
      "extends": "preview",
      "env": { "NEXUSFLEET_ARM64_ONLY": "1" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" }
    }
  }
}
